{
  "manifest_version": 3,
  "name": "Campus Tab",
  "version": "1.0.0",
  "description": "A new tab page in your university's colours: clock, quick links, campus hours, tab strip, and a focus timer.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "bookmarks",
    "topSites",
    "tabs",
    "tabGroups",
    "favicon",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
